# MongoDB Atlas connection string (keep real credentials only in .env, never in code or git)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=patient_onboarding

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# No email service yet: when true, /auth/forgot-password returns the reset link so it can be shown on screen.
# Set to false in production once email delivery is configured.
EXPOSE_RESET_LINK=true
